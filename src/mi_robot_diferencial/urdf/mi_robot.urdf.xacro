<?xml version="1.0"?>
<robot name="mi_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================== PARÁMETROS (MicroROS Yahboom) ===================== -->
  <xacro:property name="PI" value="3.14159265"/>

  <!-- Geometría -->
  <xacro:property name="largo"        value="0.1986"/>
  <xacro:property name="ancho_total"  value="0.153"/>
  <xacro:property name="via"          value="0.134"/>   <!-- centro a centro -->
  <xacro:property name="entre_ejes"   value="0.096"/>
  <xacro:property name="r_rueda"      value="0.0245"/>  <!-- diametro 49 mm -->
  <xacro:property name="ancho_rueda"  value="${ancho_total - via}"/>  <!-- 0.019 -->

  <!-- Chasis: de 15 mm a 92 mm sobre el suelo -->
  <xacro:property name="chasis_ancho" value="${via - ancho_rueda}"/>  <!-- 0.115 -->
  <xacro:property name="chasis_alto"  value="0.077"/>
  <xacro:property name="chasis_z"     value="0.0535"/>

  <!-- LiDAR MS200: centro a 108 mm; 92 + 32 = 124 mm de altura total -->
  <xacro:property name="lidar_z" value="0.108"/>
  <xacro:property name="lidar_r" value="0.035"/>
  <xacro:property name="lidar_h" value="0.032"/>

  <!-- Masas (suma = 0.906 kg) -->
  <xacro:property name="masa_total" value="0.906"/>
  <xacro:property name="m_rueda"    value="0.040"/>
  <xacro:property name="m_lidar"    value="0.060"/>
  <xacro:property name="m_camara"   value="0.020"/>
  <xacro:property name="m_chasis"   value="${masa_total - 4*m_rueda - m_lidar - m_camara}"/>

  <!-- Limites -->
  <xacro:property name="v_max"     value="1.0"/>
  <xacro:property name="w_max"     value="4.0"/>
  <xacro:property name="a_max"     value="2.0"/>
  <xacro:property name="alpha_max" value="${2*a_max/via}"/>   <!-- ~29.9 rad/s2 -->
  <xacro:property name="w_motor"   value="${450*2*PI/60}"/>   <!-- 47.1 rad/s -->
  <xacro:property name="tau_motor" value="0.392"/>            <!-- 4 kg.cm -->

  <!-- ===================== MATERIALES ===================== -->
  <material name="azul">  <color rgba="0.1 0.3 0.8 1"/></material>
  <material name="negro"> <color rgba="0.1 0.1 0.1 1"/></material>
  <material name="gris">  <color rgba="0.5 0.5 0.5 1"/></material>

  <!-- ===================== MACROS DE INERCIA ===================== -->
  <xacro:macro name="inercia_caja" params="m x y z xyz">
    <inertial>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0"
               iyy="${m*(x*x+z*z)/12}" iyz="0"
               izz="${m*(x*x+y*y)/12}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="inercia_cilindro" params="m r h xyz rpy">
    <inertial>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0"
               iyy="${m*(3*r*r+h*h)/12}" iyz="0"
               izz="${m*r*r/2}"/>
    </inertial>
  </xacro:macro>

  <!-- ===================== CHASIS ===================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${chasis_z}"/>
      <geometry><box size="${largo} ${chasis_ancho} ${chasis_alto}"/></geometry>
      <material name="azul"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${chasis_z}"/>
      <geometry><box size="${largo} ${chasis_ancho} ${chasis_alto}"/></geometry>
    </collision>
    <xacro:inercia_caja m="${m_chasis}" x="${largo}" y="${chasis_ancho}"
                        z="${chasis_alto}" xyz="0 0 ${chasis_z}"/>
  </link>

  <!-- ===================== RUEDAS (skid-steer) ===================== -->
  <xacro:macro name="rueda" params="nombre x y">
    <link name="${nombre}">
      <visual>
        <origin rpy="${PI/2} 0 0"/>
        <geometry><cylinder radius="${r_rueda}" length="${ancho_rueda}"/></geometry>
        <material name="negro"/>
      </visual>
      <collision>
        <origin rpy="${PI/2} 0 0"/>
        <geometry><cylinder radius="${r_rueda}" length="${ancho_rueda}"/></geometry>
      </collision>
      <xacro:inercia_cilindro m="${m_rueda}" r="${r_rueda}" h="${ancho_rueda}"
                              xyz="0 0 0" rpy="${PI/2} 0 0"/>
    </link>

    <joint name="${nombre}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${nombre}"/>
      <origin xyz="${x} ${y} ${r_rueda}"/>
      <axis xyz="0 1 0"/>
      <limit effort="${tau_motor}" velocity="${w_motor}"/>
    </joint>

    <gazebo reference="${nombre}">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:rueda nombre="rueda_del_izq"  x="${ entre_ejes/2}" y="${ via/2}"/>
  <xacro:rueda nombre="rueda_tras_izq" x="${-entre_ejes/2}" y="${ via/2}"/>
  <xacro:rueda nombre="rueda_del_der"  x="${ entre_ejes/2}" y="${-via/2}"/>
  <xacro:rueda nombre="rueda_tras_der" x="${-entre_ejes/2}" y="${-via/2}"/>

  <!-- ===================== LIDAR ===================== -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="${lidar_r}" length="${lidar_h}"/></geometry>
      <material name="gris"/>
    </visual>
    <collision>
      <geometry><cylinder radius="${lidar_r}" length="${lidar_h}"/></geometry>
    </collision>
    <xacro:inercia_cilindro m="${m_lidar}" r="${lidar_r}" h="${lidar_h}"
                            xyz="0 0 0" rpy="0 0 0"/>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 ${lidar_z}"/>
  </joint>

  <!-- ===================== CAMARA ===================== -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.015 0.03 0.015"/></geometry>
      <material name="negro"/>
    </visual>
    <collision>
      <geometry><box size="0.015 0.03 0.015"/></geometry>
    </collision>
    <xacro:inercia_caja m="${m_camara}" x="0.015" y="0.03" z="0.015" xyz="0 0 0"/>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${largo/2 - 0.0075} 0 0.07"/>
  </joint>

  <link name="camera_optical_link"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin rpy="${-PI/2} 0 ${-PI/2}"/>
  </joint>

  <!-- ===================== SENSORES GAZEBO ===================== -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>450</samples>
            <resolution>1</resolution>
            <min_angle>${-PI}</min_angle>
            <max_angle>${PI - 2*PI/450}</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples><resolution>1</resolution>
            <min_angle>0</min_angle><max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.03</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="camera_link">
    <sensor name="camara" type="camera">
      <topic>image_raw</topic>
      <gz_frame_id>camera_optical_link</gz_frame_id>
      <update_rate>15</update_rate>
      <always_on>true</always_on>
      <camera>
        <camera_info_topic>camera_info</camera_info_topic>
        <horizontal_fov>1.047</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.05</near><far>15</far></clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- ===================== PLUGINS ===================== -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>rueda_del_izq_joint</left_joint>
      <left_joint>rueda_tras_izq_joint</left_joint>
      <right_joint>rueda_del_der_joint</right_joint>
      <right_joint>rueda_tras_der_joint</right_joint>
      <wheel_separation>${via}</wheel_separation>
      <wheel_radius>${r_rueda}</wheel_radius>

      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>

      <max_linear_velocity>${v_max}</max_linear_velocity>
      <min_linear_velocity>${-v_max}</min_linear_velocity>
      <max_angular_velocity>${w_max}</max_angular_velocity>
      <min_angular_velocity>${-w_max}</min_angular_velocity>
      <max_linear_acceleration>${a_max}</max_linear_acceleration>
      <min_linear_acceleration>${-a_max}</min_linear_acceleration>
      <max_angular_acceleration>${alpha_max}</max_angular_acceleration>
      <min_angular_acceleration>${-alpha_max}</min_angular_acceleration>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

  <!-- Pose real (verdad de terreno) del modelo en el mundo -> /model/mi_robot/pose -->
  <gazebo>
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose>
      <publish_model_pose>true</publish_model_pose>
      <!-- En Harmonic la pose del modelo solo sale si este también es true (bug conocido) -->
      <publish_nested_model_pose>true</publish_nested_model_pose>
      <use_pose_vector_msg>false</use_pose_vector_msg>
      <update_frequency>30</update_frequency>
    </plugin>
  </gazebo>


</robot>
